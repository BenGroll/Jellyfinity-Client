<?xml version="1.0" encoding="utf-8"?>
<!--
  Android adaptive icons intentionally reserve a large safe zone. The source
  foreground already contains its own safe zone. Keeping its native bounds
  prevents the mark being enlarged past the launcher mask and clipped at the
  edges.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0dp"
    android:insetTop="0dp"
    android:insetRight="0dp"
    android:insetBottom="0dp">
    <bitmap
        android:gravity="fill"
        android:src="@mipmap/ic_launcher_foreground" />
</inset>
