        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_entries\" (\"position\" INTEGER NOT NULL, \"server_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"artist\" TEXT NULL, \"album_name\" TEXT NULL, \"duration_micros\" INTEGER NULL, \"image_item_id\" TEXT NULL, \"image_kind\" TEXT NULL, \"image_tag\" TEXT NULL, \"image_aspect_ratio\" REAL NULL, \"availability\" TEXT NOT NULL DEFAULT 'remoteOnly', PRIMARY KEY (\"position\"));"
