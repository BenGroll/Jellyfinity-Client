    {
      "name": "saved_servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_servers\" (\"id\" TEXT NOT NULL, \"base_url\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"reported_version\" TEXT NOT NULL DEFAULT '', \"server_id\" TEXT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
