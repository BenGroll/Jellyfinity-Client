      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_accounts\" (\"id\" TEXT NOT NULL, \"server_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
