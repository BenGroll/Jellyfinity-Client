        }
      ]
    },
    {
      "name": "cached_media_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_media_items\" (\"server_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"availability\" TEXT NOT NULL, \"image_item_id\" TEXT NULL, \"image_kind\" TEXT NULL, \"image_tag\" TEXT NULL, \"image_aspect_ratio\" REAL NULL, \"artists_json\" TEXT NULL, \"album_item_id\" TEXT NULL, \"album_name\" TEXT NULL, \"track_number\" INTEGER NULL, \"disc_number\" INTEGER NULL, \"duration_micros\" INTEGER NULL, \"production_year\" INTEGER NULL, \"child_count\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"server_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "cached_collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_collections\" (\"server_id\" TEXT NOT NULL, \"collection_key\" TEXT NOT NULL, \"total_count\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"server_id\", \"collection_key\"));"
        }
      ]
    },
    {
      "name": "cached_collection_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_collection_entries\" (\"server_id\" TEXT NOT NULL, \"collection_key\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"item_id\" TEXT NOT NULL, \"unavailable_reason\" TEXT NULL, PRIMARY KEY (\"server_id\", \"collection_key\", \"position\"));"
